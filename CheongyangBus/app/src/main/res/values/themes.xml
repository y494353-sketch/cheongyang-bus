<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    
    <style name="Theme.CheongyangBus" parent="Theme.Material3.Light.NoActionBar">
        
        
        <item name="colorPrimary">@color/green</item>
        
        
        <item name="colorOnPrimary">@color/white</item>
        
        
        <item name="colorPrimaryContainer">@color/green_soft</item>
        
        
        <item name="colorOnPrimaryContainer">@color/green_dark</item>
        
        
        <item name="colorSecondary">@color/green</item>
        
        
        <item name="colorSurface">@color/white</item>
        
        
        <item name="colorOnSurface">@color/ink</item>
        
        
        <item name="android:colorBackground">@color/background</item>
        
        
        <item name="android:fontFamily">sans</item>
        
        
        <item name="android:windowLightStatusBar">true</item>
        
        
        <item name="android:windowLightNavigationBar">true</item>
        
        
        <item name="materialButtonStyle">@style/BusButton</item>
        
        
        <item name="materialCardViewStyle">@style/BusCard</item>
        
    
    </style>
    
    
    <style name="BusButton" parent="Widget.Material3.Button">
        
        
        <item name="cornerRadius">14dp</item>
        
        
        <item name="android:minHeight">56dp</item>
        
        
        <item name="android:textSize">16sp</item>
        
        
        <item name="android:insetTop">0dp</item>
        
        
        <item name="android:insetBottom">0dp</item>
        
    
    </style>
    
    
    <style name="BusCard" parent="Widget.Material3.CardView.Outlined">
        
        
        <item name="cardCornerRadius">22dp</item>
        
        
        <item name="cardElevation">0dp</item>
        
        
        <item name="strokeWidth">1dp</item>
        
        
        <item name="strokeColor">@color/line</item>
        
        
        <item name="cardBackgroundColor">@color/white</item>
        
    
    </style>
    
    
    <style name="Heading">
        
        
        <item name="android:layout_width">match_parent</item>
        
        
        <item name="android:layout_height">wrap_content</item>
        
        
        <item name="android:textSize">28sp</item>
        
        
        <item name="android:textStyle">bold</item>
        
        
        <item name="android:textColor">@color/ink</item>
        
    
    </style>
    
    
    <style name="Body">
        
        
        <item name="android:layout_width">match_parent</item>
        
        
        <item name="android:layout_height">wrap_content</item>
        
        
        <item name="android:textSize">14sp</item>
        
        
        <item name="android:textColor">@color/muted</item>
        
        
        <item name="android:lineSpacingExtra">4dp</item>
        
    
    </style>
    
    
    <style name="Time" parent="Heading">
        
        
        <item name="android:textSize">32sp</item>
        
        
        <item name="android:fontFamily">sans-serif-medium</item>
        
        
        <item name="android:textColor">@color/green_dark</item>
        
    
    </style>
    

</resources>
